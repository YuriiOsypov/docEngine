{
  "name": "@docengine/engine",
  "version": "0.0.105",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/utils/tree-nodes.test.js dist/core/field-mapping.test.js dist/core/currency-format.test.js dist/core/section-visibility.test.js dist/core/formula-functions.test.js dist/core/pivot.test.js"
  }
}
