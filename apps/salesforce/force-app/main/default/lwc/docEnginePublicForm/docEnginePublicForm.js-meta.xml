<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DocEngine Public Form</masterLabel>
    <description>Guest-facing public form filler for Experience Cloud. Reads token from the page URL.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightningCommunity__Default">
            <property
                name="token"
                type="String"
                label="Form token override"
                description="Optional. Normally taken from ?token= on the URL."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
