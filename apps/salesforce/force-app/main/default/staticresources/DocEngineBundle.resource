          <option value="hide">Hide section when rule matches</option>
        </select>
      </label>
      <label class="schema-form__row">
        <span>Field</span>
        <select data-field="section-visibility-field"></select>
      </label>
      <label class="schema-form__row">
        <span>Condition</span>
        <select data-field="section-visibility-operator">
