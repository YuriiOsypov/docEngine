    <label class="schema-form__row">
      <span>PDF title</span>
      <input type="text" data-field="page-title" placeholder="Document title" />
    </label>
    <label class="schema-form__row">
      <span>Footer text</span>
      <input type="text" data-field="page-footer-text" placeholder="Optional footer" />
